# ---- Databáze ----
# Na Railway se DATABASE_URL vyplní automaticky po přidání PostgreSQL databáze.
# Lokálně nastavte ručně:
DATABASE_URL=postgres://user:password@localhost:5432/dochazka

# ---- Přihlášení do CRM ----
ADMIN_PASSWORD=zmente-toto-heslo
JWT_SECRET=nahodny-dlouhy-retezec-pro-podpis-tokenu

# ---- Twilio (telefonní linka) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=vas_auth_token
TWILIO_NUMBER=+420xxxxxxxxx
# Při lokálním testu bez Twilia nastavte na false (vypne ověření podpisu):
TWILIO_VALIDATE=true

# ---- Notifikace o nenahlášení příchodu ----
# Eskalace (SMS na pobočku po 15 min, SMS na kontaktní čísla po 30 min) se posílá
# přes Twilio – využívá TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN a TWILIO_NUMBER výše.
# TWILIO_NUMBER musí umět posílat SMS. Bez nastaveného Twilia se upozornění jen zaloguje.
#
# (Volitelné, staršÍ – nepoužívá se pro hlídání per pobočku:)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DISPATCHER_EMAIL=
DISPATCHER_PHONE=

# ---- Ostatní ----
# Po kolika hodinách se přihlášený zaměstnanec automaticky považuje za odhlášeného (zmizí z přehledu).
SHIFT_HOURS=12
# PORT nastavuje Railway automaticky; lokálně lze nechat prázdné (výchozí 3000).
PORT=3000
